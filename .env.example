# Mode Aplikasi (Dual-Build Architecture): public | admin | all
# - 'public': Hanya web pelanggan (tanpa modul admin sedikit pun, cocok untuk domain utama: indahmombabyspa.com)
# - 'admin': Khusus portal Bidan di rute root '/' (dengan noindex/nofollow, cocok untuk subdomain: admin-indahspa.pages.dev)
# - 'all': Mode gabungan untuk kemudahan development lokal & preview (web publik di '/', admin di '/portal-bidan-indah')
VITE_APP_MODE=all

# Hash SHA-256 PIN Admin (Keamanan Tinggi & Anti-Brute-Force)
# Nilai default di bawah adalah hash dari PIN '123456' untuk kemudahan pengujian lokal.
# Cara generate hash SHA-256 untuk PIN baru Anda di terminal:
# - Node.js:    node -e "console.log(require('crypto').createHash('sha256').update('PIN_ANDA').digest('hex'))"
# - PowerShell: [BitConverter]::ToString([System.Security.Cryptography.SHA256]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes('PIN_ANDA'))).Replace('-','').ToLower()
# - Linux/Mac:  echo -n "PIN_ANDA" | sha256sum | awk '{print $1}'
VITE_ADMIN_PIN_HASH=8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92

# Supabase Configuration
# Dapatkan URL dan ANON KEY dari Dashboard Supabase Anda (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Catatan: Aplikasi ini juga memiliki mode Local Storage Fallback secara otomatis
# jika variabel lingkungan Supabase belum dikonfigurasi, sehingga siap ditest kapan saja.
